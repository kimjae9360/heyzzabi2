generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String
  role                 String    @default("EMPLOYEE") // 시스템 권한: PM | EMPLOYEE
  mustChangePassword   Boolean   @default(true)
  employeeNo           String?   @unique
  department           String?
  position             String?   // 직급
  jobTitle             String?   // 직무
  status               String    @default("ACTIVE") // ACTIVE | LEAVE | RESIGNED | LOCKED
  hireDate             DateTime?
  resignDate           DateTime? // status가 RESIGNED로 바뀔 때 자동 기록(명시적으로 직접 입력하면 그 값 우선)
  slackEmail           String?
  githubEmail          String?
  techStack            String?
  certifications       String?
  pastProjects         String?
  phone                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  assignedTasks        Task[]    @relation("TaskAssignee")
  notifications        Notification[]
}

// 인앱 알림 — 배분승인대기 발생/승인/반려, 문서 검토요청 등 당사자가 화면을 직접
// 열어보기 전엔 알 방법이 없던 이벤트를 알려준다. 헤더(대시보드 상단 우측)의 종 아이콘이 이걸 읽는다.
model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String   @default("info") // info | success | warning | error
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slackWebhookUrl String?
  githubOwner     String?
  githubRepo      String?
  githubToken     String?
  // 에이전트 3종(기획서/요구사항정의서/업무배분)의 세부 설정 — JSON string.
  // 값이 없으면 각 라우트가 기존 하드코딩 기본값을 그대로 쓴다(설정 페이지 방문 전에도 안전).
  // 모양: { proposal: {temperature}, reqSpec: {temperature}, taskAssign: {temperature, minTasks, maxTasks} }
  agentConfig String?
  tasks       Task[]
  documents   ProjectDocument[]
  researchReports ResearchReport[]
  assigneeRecommendations AssigneeRecommendation[]
}

// FR-05-016/017 담당자 추천 이력 — Task.assignmentReason은 "최종 확정된" 근거만 담고 있어서
// AI가 그 시점에 실제로 제시했던 다른 후보들(확정 안 된 것 포함)은 남지 않는다. recommend-assignees
// (단건)/assign-tasks(배치) 두 경로 모두, 확정 여부와 무관하게 매 추천 시점의 스냅샷을 그대로 남긴다.
model AssigneeRecommendation {
  id            String   @id @default(uuid())
  taskId        String   // sourceDocumentId와 같은 이유로 FK 관계 없이 문자열로만 연결(참고용 기록)
  candidateData String   // JSON: 그 시점 AI가 반환한 후보 목록(userId, name, fitScore, techFit, workloadFit, experienceFit)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("BACKLOG")
  difficulty  String    @default("MEDIUM")
  difficultyReason String? // FR-05-015: 난이도 판단 근거
  estimatedHours   Float?  // FR-05-015: 예상 소요시간
  assignmentReason String? // 업무분배 탭: AI가 이 담당자를 추천한 근거 JSON({fitScore, techFit, workloadFit, experienceFit})
  gitStatus   String    @default("NONE") // FR-07-003: NONE | PENDING | IN_REVIEW | MERGED (수동 표시 — 실제 Git 연동은 FR-08에서 예정)
  progress    Int       @default(0)
  wbsStart    DateTime?
  wbsEnd      DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocumentId String? // 이 업무를 생성한 요구사항정의서(ProjectDocument) — 히스토리 추적용
  assigneeId   String?
  assignee     User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedAt  DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MeetingNote {
  id          String    @id @default(uuid())
  title       String
  content     String
  summary     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectDocument {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title           String
  meetingDate     DateTime?
  attendees       String?

  rawContent      String?

  // proposalContent / reqSpecContent are JSON strings matching a fixed template shape
  // (see src/lib/documentTemplates.ts) so they can be rendered and exported consistently.
  proposalContent      String? // ProposalDoc JSON
  proposalDraftOptions String? // ProposalDraftOption[] JSON — candidate 안 1/2/3 awaiting selection
  reqSpecContent       String? // ReqSpecDoc JSON (table rows)

  // Independent review gates: DRAFT -> PENDING_REVIEW -> APPROVED | REJECTED
  proposalStatus       String  @default("DRAFT")
  proposalRejectReason String?
  reqSpecStatus        String  @default("DRAFT")
  reqSpecRejectReason  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model ChatMessage {
  id        String   @id @default(uuid())
  role      String   // 'user' | 'ai' | 'system'
  content   String
  createdAt DateTime @default(now())
}

model AIAgent {
  id           String   @id @default(uuid())
  name         String
  role         String
  systemPrompt String
  model        String   @default("gpt-4o")
  projectId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model ResearchReport {
  id           String   @id @default(uuid())
  question     String
  content      String
  sourcesJson  String
  degraded     Boolean  @default(false)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
